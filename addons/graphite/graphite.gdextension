[configuration]

entry_symbol = "graphite_init"
compatibility_minimum = 4.4

[libraries]

linux.debug.x86_64 = "res://addons/graphite/bin/libgraphite.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/graphite/bin/libgraphite.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/graphite/bin/libgraphite.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/graphite/bin/libgraphite.windows.template_release.x86_64.dll"
macos.debug = "res://addons/graphite/bin/libgraphite.macos.template_debug.framework"
macos.release = "res://addons/graphite/bin/libgraphite.macos.template_release.framework"
